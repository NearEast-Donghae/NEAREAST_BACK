# Local development only. Copy to .env before the first Compose run.
COMPOSE_PROJECT_NAME=neareast-dev
NEAREAST_HTTP_PORT=8012
NEAREAST_DOCS_ENABLED=true
# Frontend origins allowed to call the API from a browser (comma-separated). Empty = none.
NEAREAST_CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Host-side DB address/port (also used when running Python outside Docker).
# Compose explicitly uses db:5432 inside the backend container.
NEAREAST_DB_HOST=127.0.0.1
NEAREAST_DB_PORT=55432
NEAREAST_DB_NAME=neareast
NEAREAST_DB_USER=neareast
NEAREAST_DB_PASSWORD=

# Chat: true answers from built-in mock data without any API key.
NEAREAST_CHAT_MOCK=true
# Chat requests per client address per minute (0 = no limit).
NEAREAST_CHAT_RATE_LIMIT_PER_MINUTE=60
# Legacy setting retained for PR compatibility; runtime content is loaded from PostgreSQL.
NEAREAST_CONTENT_DIR=.

# LLM (only when NEAREAST_CHAT_MOCK=false). Put the real key in .env only; never commit it.
NEAREAST_OPENAI_API_KEY=
# OPENAI_API_KEY is also accepted when the prefixed key is empty.
NEAREAST_CHAT_MODEL=gpt-5.4-nano
NEAREAST_EMBEDDING_MODEL=text-embedding-3-large
# Vector search over documents and vectors restored from NearEast_Data seed.
NEAREAST_CHAT_VECTOR_SEARCH=true
# Documents less similar to the question than this are ignored (0..1).
NEAREAST_VECTOR_MIN_SIMILARITY=0.27
# Give up on the question embedding after this many seconds and answer without it.
NEAREAST_EMBEDDING_TIMEOUT_SECONDS=2
NEAREAST_CHAT_MAX_TOKENS=1000
# Reasoning models only (e.g. gpt-5.4-nano): none|minimal|low|medium|high. Leave unset for gpt-4.1-*.
# NEAREAST_CHAT_REASONING_EFFORT=low
NEAREAST_LLM_TIMEOUT_SECONDS=8
# Whole chat request budget; past it the built-in responder answers (mode: fallback).
NEAREAST_CHAT_DEADLINE_SECONDS=12
# Bounded agent: up to NEAREAST_CHAT_AGENT_MAX_STEPS read-only lookups before an answer.
# false = one lookup at most (the earlier behaviour); switch back to it if anything goes wrong.
NEAREAST_CHAT_AGENT=false
NEAREAST_CHAT_AGENT_MAX_STEPS=4
NEAREAST_LLM_USAGE_LOG=


NEAREAST_SESSION_COOKIE_NAME=neareast_session
NEAREAST_SESSION_LIFETIME_HOURS=168
# Set true when serving over HTTPS.
NEAREAST_COOKIE_SECURE=false

NEAREAST_TMAP_API_KEY=
