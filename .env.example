# Local development only. Copy to .env before the first Compose run.
NEAREAST_HTTP_PORT=8012
NEAREAST_DOCS_ENABLED=true

# Host-side DB address/port (also used when running Python outside Docker).
# Compose explicitly uses db:5432 inside the backend container.
NEAREAST_DB_HOST=127.0.0.1
NEAREAST_DB_PORT=5432
NEAREAST_DB_NAME=neareast
NEAREAST_DB_USER=neareast
NEAREAST_DB_PASSWORD=neareast_local_dev_only

# Chat: true answers from built-in mock data without any API key.
NEAREAST_CHAT_MOCK=true
# Folder holding knowledge/ and data/ (default: current working directory).
NEAREAST_CONTENT_DIR=.
