# Local development only. Copy to .env before the first Compose run.
NEAREAST_HTTP_PORT=8012
NEAREAST_DOCS_ENABLED=true
# Frontend origins allowed to call the API from a browser (comma-separated). Empty = none.
NEAREAST_CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000

# Host-side DB address/port (also used when running Python outside Docker).
# Compose explicitly uses db:5432 inside the backend container.
NEAREAST_DB_HOST=127.0.0.1
NEAREAST_DB_PORT=5432
NEAREAST_DB_NAME=neareast
NEAREAST_DB_USER=neareast
NEAREAST_DB_PASSWORD=neareast_local_dev_only

# Chat: true answers from built-in mock data without any API key.
NEAREAST_CHAT_MOCK=true
# Chat requests per client address per minute (0 = no limit).
NEAREAST_CHAT_RATE_LIMIT_PER_MINUTE=60
# Folder holding knowledge/ and data/ (default: current working directory).
NEAREAST_CONTENT_DIR=.

# LLM (only when NEAREAST_CHAT_MOCK=false). Put the real key in .env only; never commit it.
NEAREAST_OPENAI_API_KEY=
NEAREAST_CHAT_MODEL=gpt-5.4-nano
NEAREAST_EMBEDDING_MODEL=text-embedding-3-small
NEAREAST_CHAT_MAX_TOKENS=1000
# Reasoning models only (e.g. gpt-5.4-nano): none|minimal|low|medium|high. Leave unset for gpt-4.1-*.
# NEAREAST_CHAT_REASONING_EFFORT=low
NEAREAST_LLM_TIMEOUT_SECONDS=8
NEAREAST_LLM_USAGE_LOG=llm_usage.jsonl
