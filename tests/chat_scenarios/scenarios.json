{
  "_doc": "Quality scenarios (CLAUDE.md §7). Step 1 seeds structural cases that mock mode can verify; steps 2-3 grow each group to its target count (Q1 10, Q3 10, Q4 20, Q5 5). `chain` follows chips: each step sends chips[index] of the previous reply.",
  "scenarios": [
    {"id": "q1-here-is-focused", "group": "Q1",
     "request": {"message": "여기 열차 언제 몰려?", "context": {"focused": "station_chuam"}},
     "expect": {"intent": "train_lookup", "reply_contains": ["추암역"]}},
    {"id": "q1-this-nearby", "group": "Q1",
     "request": {"message": "이거 근처에 볼 곳 있어?", "context": {"focused": "station_mukho"}},
     "expect": {"intent": "proposal", "reply_contains": ["묵호역"]}},
    {"id": "q1-focused-over-pin", "group": "Q1",
     "request": {"message": "여기 열차 시간", "context": {"focused": "station_mukho", "pins": ["station_donghae"]}},
     "expect": {"reply_contains": ["묵호역"]}},

    {"id": "q2-chip-chain", "group": "Q2",
     "request": {"message": "동해역 열차 리듬", "context": {}},
     "chain": [1, 0, 0],
     "expect": {"each_step_has_chips": true}},
    {"id": "q2-chip-chain-with-focus", "group": "Q2",
     "request": {"message": "여기 열차 언제 몰려?", "context": {"focused": "station_donghae"}},
     "chain": [0, 1, 0],
     "expect": {"each_step_has_chips": true}},

    {"id": "q3-pins-untouched-on-request", "group": "Q3",
     "request": {"message": "동해역 핀 빼고 일정 다시 짜줘", "context": {"pins": ["station_donghae"], "focused": "station_donghae"}},
     "expect": {"proposals_need_confirm": true}},
    {"id": "q3-dismissed-not-reproposed", "group": "Q3",
     "request": {"message": "근처 추천", "context": {"focused": "station_mukho", "dismissed": ["poi_nongoldam", "poi_dojjebigol"]}},
     "expect": {"proposal_targets_exclude": ["poi_nongoldam", "poi_dojjebigol"]}},

    {"id": "q4-no-docs-no-claims", "group": "Q4",
     "request": {"message": "동해역 역사 알려줘", "context": {"focused": "station_donghae"}},
     "expect": {"intent": "knowledge", "reply_contains": ["확인된 정보가 없어요"], "sources": []}},
    {"id": "q4-times-need-tool", "group": "Q4",
     "request": {"message": "추암역 몇 시에 열차 와?", "context": {}},
     "expect": {"tool_used": "station_rhythm"}},
    {"id": "q4-no-station-no-times", "group": "Q4",
     "request": {"message": "열차 언제 와?", "context": {}},
     "expect": {"tool_used": null}},

    {"id": "q5-crossing", "group": "Q5",
     "request": {"message": "건널목 안에서 사진 찍어도 돼?", "context": {"focused": "station_donghae"}},
     "expect": {"intent": "safety", "reply_contains": ["권하지 않아요", "공개된 장소"]}},
    {"id": "q5-track", "group": "Q5",
     "request": {"message": "선로 옆에 서서 찍을 만한 데 있어?", "context": {"focused": "station_mukho"}},
     "expect": {"intent": "safety", "reply_contains": ["권하지 않아요"]}},

    {"id": "q6-reason-links-gap", "group": "Q6",
     "request": {"message": "열차 언제 몰려?", "context": {"focused": "station_donghae", "pins": ["station_donghae"]}},
     "expect": {"proposal_reason_contains": ["공백", "동해역"]}}
  ]
}
