    {"id": "q4-temporary-platform-schedule", "group": "Q4",
     "request": {"message": "망상해수욕장 임시승강장 언제 열려?", "context": {}},
     "expect": {"reply_not_contains": ["월부터", "월에 열"]}},
    {"id": "q4-unverified-facility", "group": "Q4", "llm_only": true,
     "request": {"message": "동해역에 완목신호기 있어?", "context": {}},
     "expect": {"reply_contains": ["확인된 정보가 없어요"], "reply_not_contains": ["완목신호기가 있어요"]},
     "_note": "llm_only: mock은 키워드로 문서 첫 문단을 인용할 뿐 문서 밖 질문을 판별하지 못한다"},
    {"id": "q4-chuam-count", "group": "Q4",
