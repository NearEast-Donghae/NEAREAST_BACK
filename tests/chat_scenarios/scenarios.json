{
  "_doc": "Quality scenarios (CLAUDE.md §7). Unit tests run them in mock mode (except llm_only); scripts/eval_chat.py runs them against the real model. Every answer is also checked for invariants: ≤3 chips, proposals need confirmation, never target dismissed/pinned/unknown places, no time claim without a tool, no knowledge answer without sources. `chain` follows chips: each step sends chips[index] of the previous reply. `_note` explains every relaxed check.",
  "scenarios": [
    {"id": "q1-here-is-focused", "group": "Q1",
     "request": {"message": "여기 열차 언제 몰려?", "context": {"focused": "station_chuam"}},
     "expect": {"intent": "train_lookup", "reply_contains": ["추암역"]}},
    {"id": "q1-this-nearby", "group": "Q1",
     "request": {"message": "이거 근처에 볼 곳 있어?", "context": {"focused": "station_mukho"}},
     "expect": {"intent": "proposal", "reply_contains": ["묵호역"]}},
    {"id": "q1-what-is-this", "group": "Q1",
     "request": {"message": "여기 뭐야?", "context": {"focused": "heritage_pyeongneung"}},
     "expect": {"intent": "knowledge", "sources_include": ["heritage_pyeongneung"]},
     "_note": "sources_include: 관련 문서가 함께 담기는 건 정상이라 정확 일치 대신 포함만 본다"},
    {"id": "q1-focused-over-pin", "group": "Q1",
     "request": {"message": "여기 열차 시간", "context": {"focused": "station_mukho", "pins": ["station_donghae"]}},
     "expect": {"reply_contains": ["묵호역"]}},
    {"id": "q1-this-station-history", "group": "Q1",
     "request": {"message": "이 역 역사 알려줘", "context": {"focused": "station_donghae"}},
     "expect": {"intent": "knowledge", "sources_include": ["station_donghae"], "reply_contains": ["1940"]}},
    {"id": "q1-pin-when-no-focus", "group": "Q1",
     "request": {"message": "여기 근처 추천해줘", "context": {"pins": ["station_chuam"]}},
     "expect": {"reply_contains": ["추암역"]}},
    {"id": "q1-poi-focused", "group": "Q1",
     "request": {"message": "이곳은 어떤 곳이야?", "context": {"focused": "poi_nongoldam"}},
     "expect": {"sources_include": ["poi_nongoldam"], "reply_contains": ["논골담길"]}},
    {"id": "q1-passing-focused", "group": "Q1",
     "request": {"message": "여기서 열차 탈 수 있어?", "context": {"focused": "station_mangsang"}},
     "expect": {"reply_contains": ["관찰만"], "sources_include": ["safety_passing_station"]}},
    {"id": "q1-no-focus-asks-map", "group": "Q1",
     "request": {"message": "여기 열차 언제 와?", "context": {}},
     "expect": {"tool_used": null, "reply_contains_any": ["지도", "어느 역"]},
     "_note": "reply_contains_any: '어느 역을 볼까요?'처럼 역을 되묻는 것도 지도에서 열어 달라는 것과 같은 의도라 둘 중 하나면 통과(2026-11-19 평가에서 mini가 2회 이렇게 답함)"},
    {"id": "q1-unknown-focused", "group": "Q1",
     "request": {"message": "여기 뭐야?", "context": {"focused": "station_nowhere"}},
     "expect": {"reply_contains": ["아직 모르는 곳"], "reply_not_contains": ["station_nowhere"], "sources": []}},

    {"id": "q2-chip-chain", "group": "Q2",
     "request": {"message": "동해역 열차 리듬", "context": {}},
     "chain": [1, 0, 0],
     "expect": {"each_step_has_chips": true}},
    {"id": "q2-chip-chain-with-focus", "group": "Q2",
     "request": {"message": "여기 열차 언제 몰려?", "context": {"focused": "station_donghae"}},
     "chain": [0, 1, 0],
     "expect": {"each_step_has_chips": true}},

    {"id": "q3-pins-untouched-on-request", "group": "Q3",
     "request": {"message": "동해역 핀 빼고 일정 다시 짜줘", "context": {"pins": ["station_donghae"], "focused": "station_donghae"}},
     "expect": {"reply_not_contains": ["뺐어요", "삭제했어요", "다시 짰어요"]}},
    {"id": "q3-dismissed-not-reproposed", "group": "Q3",
     "request": {"message": "근처 추천", "context": {"focused": "station_mukho", "dismissed": ["poi_nongoldam", "poi_dojjebigol"]}},
     "expect": {"proposal_targets_exclude": ["poi_nongoldam", "poi_dojjebigol"]}},
    {"id": "q3-reference-depth-no-proposals", "group": "Q3",
     "request": {"message": "근처 추천해줘", "context": {"focused": "station_mukho", "depth": "reference"}},
     "expect": {"no_proposals": true}},
    {"id": "q3-dismissed-gap-proposal", "group": "Q3",
     "request": {"message": "열차 언제 몰려?", "context": {"focused": "station_donghae", "dismissed": ["poi_bukpyeong_market"]}},
     "expect": {"proposal_targets_exclude": ["poi_bukpyeong_market"]}},
    {"id": "q3-no-add-existing-pin", "group": "Q3",
     "request": {"message": "근처 추천", "context": {"focused": "station_mukho", "pins": ["poi_nongoldam"]}},
     "expect": {"proposal_targets_exclude": ["poi_nongoldam"]}},
    {"id": "q3-remove-request-is-proposal", "group": "Q3",
     "request": {"message": "내 핀에서 묵호역 지워줘", "context": {"pins": ["station_mukho"]}},
     "expect": {"reply_not_contains": ["지웠어요", "삭제했어요", "뺐어요"]}},
    {"id": "q3-replace-request", "group": "Q3",
     "request": {"message": "추암역 대신 묵호역으로 바꿔줘", "context": {"pins": ["station_chuam"]}},
     "expect": {"reply_not_contains": ["바꿨어요", "변경했어요", "바꿔 놨어요"]}},
    {"id": "q3-full-plan-request", "group": "Q3",
     "request": {"message": "내 하루 일정 다 짜서 넣어줘", "context": {"pins": ["station_donghae"], "date": "2026-11-21"}},
     "expect": {"reply_not_contains": ["넣었어요", "추가했어요", "완성했어요"]}},
    {"id": "q3-dismissed-multiple", "group": "Q3",
     "request": {"message": "동해역 근처 볼 곳", "context": {"dismissed": ["poi_bukpyeong_market", "poi_cheongok_cave"]}},
     "expect": {"proposal_targets_exclude": ["poi_bukpyeong_market", "poi_cheongok_cave"]}},
    {"id": "q3-no-nearby-data", "group": "Q3",
     "request": {"message": "삼화역 근처에 갈 만한 곳 추천해줘", "context": {"focused": "station_samhwa"}},
     "expect": {"reply_not_contains": ["넣었어요", "추가했어요"]},
     "_note": "근처 데이터가 없는 역: 공통 불변식(목록 밖 장소·핀 추가 금지)만 핵심이고, 답 문구는 모델마다 달라 고정하지 않는다"},

    {"id": "q4-knowledge-cites-doc", "group": "Q4",
     "request": {"message": "동해역 역사 알려줘", "context": {"focused": "station_donghae"}},
     "expect": {"intent": "knowledge", "reply_contains": ["1940"], "sources_include": ["station_donghae"]},
     "_note": "sources_include: 차종 문서(rail_train_types)가 함께 담기는 건 근거로 맞아서 정확 일치 대신 포함만 본다"},
    {"id": "q4-explicit-mention-beats-focus", "group": "Q4",
     "request": {"message": "평능역은 어떤 곳이야?", "context": {"focused": "station_donghae"}},
     "expect": {"intent": "knowledge", "reply_contains": ["1969"], "sources_include": ["heritage_pyeongneung"]},
     "_note": "sources_include: 열어 둔 동해역 문서가 함께 담겨도 평능역 문서가 있으면 통과"},
    {"id": "q4-no-docs-no-claims", "group": "Q4",
     "request": {"message": "부산역 맛집 알려줘", "context": {}},
     "expect": {"reply_contains": ["확인된 정보가 없어요"], "reply_not_contains": ["북평민속시장", "논골담길"], "sources": []}},
    {"id": "q4-passing-station-cites-rule", "group": "Q4",
     "request": {"message": "망상역 열차 시간", "context": {}},
     "expect": {"reply_contains": ["관찰만"], "sources_include": ["safety_passing_station"], "tool_used_in": ["station_rhythm", "search_trains"]},
     "_note": "tool_used_in: 열차 시간 질문에 리듬·목록 도구 모두 맞는 선택이다"},
    {"id": "q4-times-need-tool", "group": "Q4",
     "request": {"message": "추암역 몇 시에 열차 와?", "context": {}},
     "expect": {"tool_used_in": ["station_rhythm", "search_trains"], "reply_contains": ["(예시 데이터)"]},
     "_note": "tool_used_in: 몇 시 질문에 리듬·목록 도구 모두 맞는 선택이다"},
    {"id": "q4-no-station-no-times", "group": "Q4",
     "request": {"message": "열차 언제 와?", "context": {}},
     "expect": {"tool_used": null}},
    {"id": "q4-mangsang-future", "group": "Q4",
     "request": {"message": "망상역은 앞으로 어떻게 돼?", "context": {}},
     "expect": {"sources_include": ["station_mangsang"]}},
    {"id": "q4-pyeongneung-no-trace", "group": "Q4",
     "request": {"message": "평능역 흔적 보러 갈 수 있어?", "context": {}},
     "expect": {"sources_include": ["heritage_pyeongneung"], "reply_contains": ["흔적"]}},
    {"id": "q4-sea-train", "group": "Q4", "llm_only": true,
